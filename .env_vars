# Shared template — copy to .env_vars_dev and fill in paths for your machine.
# .env_vars_dev is gitignored and sourced by train_single_node.slurm.

# Checkpoint / job output root (required for train_configs using ${oc.env:DUMP_DIR})
export DUMP_DIR=""

# Chem training data root (chemlactica_train / chemlactica_valid in hf_datasets.py)
export CHEMLACTICA_DATA_DIR=""

# PubChem JSONL root (pubchem_train / pubchem_valid); optional unless using pubchem datasets
export PUBCHEM_DATA_DIR=""

# Tokenizer directory (repo-relative path or absolute)
export TOKENIZER_PATH=""

# Slurm log directory (export before sbatch if overriding #SBATCH --output paths)
export SLURM_LOG_DIR=""

# Optional
export HF_TOKEN=""
export PYTORCH_KERNEL_CACHE_PATH=""
export CONDA_ROOT=""
